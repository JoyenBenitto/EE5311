#%lvsdb-klayout

# Layout
layout(
 top(inv)
 unit(0.001)

 # Layer section
 # This section lists the mask layers (drawing or derived) and their connections.

 # Mask layers
 layer(net_markers '9000/0')

 # Mask layer connectivity
 connect(net_markers net_markers)

 # Device class section
 class(sky130_fd_pr__pfet_01v8 MOS4)
 class(sky130_fd_pr__nfet_01v8 MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(inv

  # Circuit boundary
  rect((-1535 95) (1310 2955))

  # Nets with their geometries
  net(1 name(out)
   rect(net_markers (-705 1330) (100 100))
  )
  net(2 name(in)
   rect(net_markers (-1535 1255) (100 100))
  )
  net(3 name(DVDD)
   rect(net_markers (-325 2950) (100 100))
  )
  net(4 name(DGND)
   rect(net_markers (-405 95) (100 100))
  )

  # Devices and their connections
  device(1 sky130_fd_pr__pfet_01v8
   name('0')
   param(L 0.15)
   param(W 0.84)
   param(AS 0.252)
   param(AD 0.252)
   param(PS 2.28)
   param(PD 2.28)
   terminal(S 3)
   terminal(G 2)
   terminal(D 1)
   terminal(B 3)
  )
  device(2 sky130_fd_pr__nfet_01v8
   name('1')
   param(L 0.15)
   param(W 0.42)
   param(AS 0.126)
   param(AD 0.126)
   param(PS 1.44)
   param(PD 1.44)
   terminal(S 4)
   terminal(G 2)
   terminal(D 1)
   terminal(B 4)
  )

 )
)

# Reference netlist
reference(

 # Device class section
 class(SKY130_FD_PR__PFET_01V8 MOS4)
 class(SKY130_FD_PR__NFET_01V8 MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(INV

  # Nets
  net(1 name(DVDD))
  net(2 name(IN))
  net(3 name(OUT))
  net(4 name(DGND))

  # Outgoing pins and their connections to nets
  pin(1 name(DVDD))
  pin(2 name(IN))
  pin(3 name(OUT))
  pin(4 name(DGND))

  # Devices and their connections
  device(1 SKY130_FD_PR__PFET_01V8
   name(M3)
   param(L 0.15)
   param(W 0.84)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 1)
   terminal(G 2)
   terminal(D 3)
   terminal(B 1)
  )
  device(2 SKY130_FD_PR__NFET_01V8
   name(M2)
   param(L 0.15)
   param(W 0.42)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 4)
   terminal(G 2)
   terminal(D 3)
   terminal(B 4)
  )

 )
)

# Cross reference
xref(
 circuit(inv INV match
  xref(
   net(4 4 match)
   net(3 1 match)
   net(2 2 match)
   net(1 3 match)
   pin(() 3 match)
   pin(() 0 match)
   pin(() 1 match)
   pin(() 2 match)
   device(2 2 match)
   device(1 1 match)
  )
 )
)
