v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -45 -6 0 0 0.3 0.3 {}
T {@name} 135 -52 0 0 0.2 0.2 {}
P 4 5 130 -40 -130 -40 -130 40 130 40 130 -40 {}
B 5 147.5 -32.5 152.5 -27.5 {name=DVDD dir=inout}
L 7 130 -30 150 -30 {}
T {DVDD} 125 -34 0 1 0.2 0.2 {}
B 5 147.5 -12.5 152.5 -7.5 {name=out dir=out}
L 4 130 -10 150 -10 {}
T {out} 125 -14 0 1 0.2 0.2 {}
B 5 -152.5 -32.5 -147.5 -27.5 {name=in dir=in}
L 4 -150 -30 -130 -30 {}
T {in} -125 -34 0 0 0.2 0.2 {}
B 5 147.5 7.5 152.5 12.5 {name=DGND dir=inout}
L 7 130 10 150 10 {}
T {DGND} 125 6 0 1 0.2 0.2 {}
B 5 147.5 27.5 152.5 32.5 {name=vout1 dir=out}
L 4 130 30 150 30 {}
T {vout1} 125 26 0 1 0.2 0.2 {}
