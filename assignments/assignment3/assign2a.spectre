// sch_path: /home/joyen/ee5311/EE5311/assignments/assignment3/assign2a.sch
//subckt assign2a ( )
x1 ( net1 vout ) inverter 
x2 ( net2 net1 ) inverter 
x3 ( net3 net2 ) inverter 
x4 ( net4 net3 ) inverter 
x5 ( net5 net4 ) inverter 
x6 ( net6 net5 ) inverter 
x7 ( vout net6 ) inverter 
V1 ( VDD GND ) vsource '1.8' 
//// begin user architecture code


.param VDDVal=1.8
.param width_p=0.84

* Force Vout to 0V at t=0 to kickstart the oscillation
.ic v(vout)=0

.control
* Run transient analysis for 5ns. 
* The 'uic' (Use Initial Conditions) flag is MANDATORY here, otherwise Ngspice ignores the .ic command!
tran 1p 5n uic

* Measure the time of the 3rd and 4th rising edges (waiting a few cycles lets it stabilize)
meas tran t1 trig v(vout) val=0.9 rise=3
meas tran t2 trig v(vout) val=0.9 rise=4

* Calculate period and frequency (Frequency=1 / Period)
let period=t2 - t1
let freq=1 / period

* Print the results to the terminal
print period
print freq

* Plot the oscillating waveform
plot v(vout)
.endc


//// end user architecture code
//ends

// expanding   symbol:  inverter.sym # of pins=2
