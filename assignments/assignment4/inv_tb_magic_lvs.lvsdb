#%lvsdb-klayout

# Layout
layout(
 top(inv_tb)
 unit(0.001)

 # Layer section
 # This section lists the mask layers (drawing or derived) and their connections.

 # Mask layers
 layer(net_markers '9000/0')

 # Mask layer connectivity
 connect(net_markers net_markers)

 # Device class section
 class(sky130_fd_pr__pfet_01v8 MOS4)
 class(sky130_fd_pr__nfet_01v8 MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(inv_tb

  # Circuit boundary
  rect((-2630 200) (2215 2910))

  # Nets with their geometries
  net(1 name(out)
   rect(net_markers (-515 1345) (100 100))
  )
  net(2 name(vout1)
   rect(net_markers (-1330 1300) (100 100))
  )
  net(3 name(in)
   rect(net_markers (-2630 1310) (100 100))
  )
  net(4 name(DVDD)
   rect(net_markers (-1385 3010) (100 100))
  )
  net(5 name(DGND)
   rect(net_markers (-1575 200) (100 100))
  )

  # Devices and their connections
  device(1 sky130_fd_pr__pfet_01v8
   name('0')
   param(L 0.15)
   param(W 0.84)
   param(AS 0.252)
   param(AD 0.252)
   param(PS 2.28)
   param(PD 2.28)
   terminal(S 4)
   terminal(G 3)
   terminal(D 2)
   terminal(B 4)
  )
  device(2 sky130_fd_pr__pfet_01v8
   name('1')
   param(L 0.15)
   param(W 0.84)
   param(AS 0.252)
   param(AD 0.252)
   param(PS 2.28)
   param(PD 2.28)
   terminal(S 4)
   terminal(G 2)
   terminal(D 1)
   terminal(B 4)
  )
  device(3 sky130_fd_pr__nfet_01v8
   name('2')
   param(L 0.15)
   param(W 0.42)
   param(AS 0.126)
   param(AD 0.126)
   param(PS 1.44)
   param(PD 1.44)
   terminal(S 5)
   terminal(G 3)
   terminal(D 2)
   terminal(B 5)
  )
  device(4 sky130_fd_pr__nfet_01v8
   name('3')
   param(L 0.15)
   param(W 0.42)
   param(AS 0.126)
   param(AD 0.126)
   param(PS 1.44)
   param(PD 1.44)
   terminal(S 5)
   terminal(G 2)
   terminal(D 1)
   terminal(B 5)
  )

 )
)

# Reference netlist
reference(

 # Device class section
 class(SKY130_FD_PR__PFET_01V8 MOS4)
 class(SKY130_FD_PR__NFET_01V8 MOS4)

 # Circuit section
 # Circuits are the hierarchical building blocks of the netlist.
 circuit(INV_TB

  # Nets
  net(1 name(OUT))
  net(2 name(IN))
  net(3 name(VOUT1))
  net(4 name(DGND))
  net(5 name(DVDD))

  # Outgoing pins and their connections to nets
  pin(1 name(OUT))
  pin(2 name(IN))
  pin(3 name(VOUT1))
  pin(4 name(DGND))
  pin(5 name(DVDD))

  # Devices and their connections
  device(1 SKY130_FD_PR__PFET_01V8
   name('0')
   param(L 0.15)
   param(W 0.84)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 5)
   terminal(G 2)
   terminal(D 3)
   terminal(B 5)
  )
  device(2 SKY130_FD_PR__PFET_01V8
   name('1')
   param(L 0.15)
   param(W 0.84)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 5)
   terminal(G 3)
   terminal(D 1)
   terminal(B 5)
  )
  device(3 SKY130_FD_PR__NFET_01V8
   name('2')
   param(L 0.15)
   param(W 0.42)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 4)
   terminal(G 2)
   terminal(D 3)
   terminal(B 4)
  )
  device(4 SKY130_FD_PR__NFET_01V8
   name('3')
   param(L 0.15)
   param(W 0.42)
   param(AS 0)
   param(AD 0)
   param(PS 0)
   param(PD 0)
   terminal(S 4)
   terminal(G 3)
   terminal(D 1)
   terminal(B 4)
  )

 )
)

# Cross reference
xref(
 circuit(inv_tb INV_TB match
  xref(
   net(5 4 match)
   net(4 5 match)
   net(3 2 match)
   net(1 1 match)
   net(2 3 match)
   pin(() 3 match)
   pin(() 4 match)
   pin(() 1 match)
   pin(() 0 match)
   pin(() 2 match)
   device(3 3 match)
   device(4 4 match)
   device(1 1 match)
   device(2 2 match)
  )
 )
)
